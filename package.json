{
  "name": "cashback-system",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:local": "bash ./scripts/dev-local.sh",
    "build": "turbo build",
    "analyze:admin": "ANALYZE=true pnpm --filter @cashback/admin build",
    "analyze:merchant": "ANALYZE=true pnpm --filter @cashback/merchant build",
    "analyze:user": "ANALYZE=true pnpm --filter @cashback/user build",
    "analyze": "pnpm analyze:user && pnpm analyze:merchant && pnpm analyze:admin",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "db:generate": "pnpm --filter @cashback/database generate",
    "db:push": "pnpm --filter @cashback/database exec prisma db push --schema prisma/schema.prisma --skip-generate",
    "db:migrate": "pnpm --filter @cashback/database migrate:dev",
    "db:migrate:deploy": "pnpm --filter @cashback/database migrate:deploy",
    "db:seed:exchange": "node packages/database/prisma/seed-exchange.mjs",
    "db:seed": "pnpm --filter @cashback/database seed",
    "db:seed:preview": "pnpm db:seed && pnpm db:seed:exchange",
    "db:studio": "pnpm --filter @cashback/database studio"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.14",
    "@prisma/nextjs-monorepo-workaround-plugin": "^7.7.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
